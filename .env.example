# Copy this file to .env.local for local development.
# On Vercel, add each of these under Project → Settings → Environment Variables.
# NEVER commit real secrets to GitHub.

# The public address of the website (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in

# --- Supabase (database + admin login) ---
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret! Server-only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (payments) ---
# Razorpay Dashboard → Account & Settings → API Keys (use Test keys first)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → the secret you type when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Resend (emails) ---
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. "Casa Atleta <hello@your-domain.in>"
EMAIL_FROM=Casa Atleta <hello@your-domain.in>
# Where contact-form and partnership enquiries are sent
ORGANISER_EMAIL=hello@your-domain.in

# --- Contact details shown on the website ---
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.in
NEXT_PUBLIC_WHATSAPP_NUMBER=+91XXXXXXXXXX
NEXT_PUBLIC_INSTAGRAM_HANDLE=casaatleta

# --- Analytics (optional) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
